# Copiaza acest fisier ca ".env" (langa docker-compose.yml): copy env.example .env
# Apoi completeaza valorile mai jos.
# Fisierul ".env" NU se urca pe GitHub (este in .gitignore).

# Parola contului "sa" al SQL Server din container.
# Minim 8 caractere, cu litere mari, mici, cifre si simbol.
MSSQL_SA_PASSWORD=Parola_Puternica_123!

# Cheia Gemini (Google AI Studio)
GEMINI_API_KEY=

# Opțional (nefolosit daca Interpretation:Provider = Gemini)
OPENAI_API_KEY=

# Parola SMTP Brevo
BREVO_SMTP_PASSWORD=

# Stripe - chei de TEST cat timp rulam local
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
