@model MedicalApp.Models.InterpretationUploadViewModel
@{
    ViewData["Title"] = Loc.T("InterpretTitle");
    var creditRest = (int)(ViewBag.CreditRest ?? 0);
    var errorMessage = TempData["ErrorMessage"] as string;
    var hasErrors = !ViewData.ModelState.IsValid;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="text-center mb-4">
                <h2 class="text-primary fw-bold">@Loc.T("InterpretTitle")</h2>
                <p class="text-muted">@Loc.T("InterpretIntro")</p>
            </div>

            <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <strong>@Loc.T("PaidCreditsLabel"):</strong> @ViewBag.CreditRest
                    &nbsp;|&nbsp;
                    <strong>@Loc.T("BonusCreditsLabel"):</strong> @ViewBag.BonusCreditsRemaining
                    &nbsp;|&nbsp;
                    <strong>@Loc.T("TotalAvailableLabel"):</strong>
                    <span class="fw-bold text-success">@ViewBag.TotalAvailableCredits</span>
                </div>
                <small class="text-muted">@Loc.T("OneCreditPerInterpretation")</small>
            </div>

            @if (ViewBag.HasRunningJob as bool? == true)
            {
                <div class="alert alert-info d-flex align-items-start gap-2"
                     data-testid="interpretation-running-banner">
                    <span class="spinner-border spinner-border-sm mt-1" role="status"></span>
                    <div>@Loc.T("InterpretationRunningBanner")</div>
                </div>
            }

            @if (ViewBag.LoincOffline as bool? == true)
            {
                <div class="alert alert-warning d-flex align-items-start gap-2"
                     data-testid="loinc-offline-warning">
                    <span class="fs-5 lh-1">&#9888;</span>
                    <div>
                        <strong>@Loc.T("LoincOfflineWarningTitle")</strong>
                        <div class="small">@Loc.T("LoincOfflineWarningBody")</div>
                        <div class="small text-muted mt-1">@ViewBag.LoincOfflineDetail</div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            @if (hasErrors)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="All" class="mb-0"></div>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm">
                        <input type="hidden" name="progressToken" id="progressToken" value="" />
                        @Html.AntiForgeryToken()

                        <!-- Step 1: Profile selection -->
                        <div class="mb-4">
                            <label asp-for="ProfileId" class="form-label fw-semibold">
                                &#128106; @Loc.T("InterpretWhoForLabel")
                            </label>
                            @{
                                // Feb 2026 anti-abuse gate — B2C users need paid credits
                                // to add extra family profiles (see ProfileGateService).
                                var canCreateProfile = ViewBag.CanCreateProfile as bool? ?? true;
                                // June 2026: 20 profiles maximum — buying credits
                                // does not lift this, so don't send them to /Credits.
                                var atProfileLimit = ViewBag.ProfileLimitReached as bool? ?? false;
                                // CM accounts search their patients; B2C keeps the dropdown.
                                var profileSearchEnabled = ViewBag.ProfileSearchEnabled as bool? ?? false;
                            }
                            <div class="input-group profile-select-group">
                                @* Cabinet Medical (up to 2000 patients): a searchable picker
                                   that queries the server, instead of a 2000-option dropdown.
                                   B2C keeps the plain select — same markup as before. *@
                                @if (profileSearchEnabled)
                                {
                                    <div class="patient-picker profile-select-input" data-testid="interpret-patient-picker">
                                        <input type="hidden" asp-for="ProfileId" id="patientPickerId" />
                                        <input type="text" id="patientPickerInput" class="form-control form-control-lg"
                                               placeholder="@Loc.T("InterpretPatientSearchPlaceholder")"
                                               autocomplete="off" role="combobox" aria-expanded="false"
                                               aria-controls="patientPickerList"
                                               value="@(Model.AvailableProfiles.FirstOrDefault(p => p.Id == Model.ProfileId)?.Name ?? "")"
                                               data-testid="interpret-patient-search" />
                                        <div id="patientPickerList" class="patient-picker-list d-none"
                                             role="listbox" data-testid="interpret-patient-results"></div>
                                    </div>
                                }
                                else
                                {
                                    <select asp-for="ProfileId" class="form-select form-select-lg profile-select-input"
                                            data-testid="interpret-profile-select" required>
                                        <option value="">@Loc.T("InterpretSelectProfilePlaceholder")</option>
                                        @foreach (var p in Model.AvailableProfiles)
                                        {
                                            <option value="@p.Id">
                                                @p.Name@(p.IsDefault ? Loc.T("ProfileDefaultSuffix") : "")
                                            </option>
                                        }
                                    </select>
                                }
                                @if (canCreateProfile)
                                {
                                    <a asp-controller="Profiles" asp-action="Create"
                                       class="btn btn-outline-primary"
                                       title="@Loc.T("InterpretAddProfileBtnTooltip")"
                                       data-testid="interpret-add-profile-btn">
                                        &#43; @Loc.T("InterpretAddProfileBtn")
                                    </a>
                                }
                                else if (atProfileLimit)
                                {
                                    <span class="btn btn-outline-secondary disabled"
                                          title="@string.Format(Loc.T("ProfileLimitTooltip"), (ViewBag.ProfileLimit as int? ?? 0))"
                                          data-testid="interpret-add-profile-btn-maxed">
                                        &#128274; @Loc.T("InterpretAddProfileBtn")
                                    </span>
                                }
                                else
                                {
                                    <a asp-controller="Credits" asp-action="Buy"
                                       class="btn btn-outline-secondary"
                                       title="@Loc.T("ProfileLockTooltip")"
                                       data-testid="interpret-add-profile-btn-locked">
                                        &#128274; @Loc.T("InterpretAddProfileBtn")
                                    </a>
                                }
                            </div>
                            <span asp-validation-for="ProfileId" class="text-danger small"></span>
                            <div class="form-text d-flex align-items-center gap-2 flex-wrap">
                                <span>@Loc.T("InterpretProfileHelp")</span>
                                <partial name="_ProfileQuotaBadge" />
                            </div>
                        </div>

                        <!-- Step 2: PDF upload (custom localized file input — the native
                             "Choose File / No file chosen" text comes from the browser and
                             cannot be translated, so we hide it and show our own UI). -->
                        <div class="mb-3">
                            <label asp-for="PdfFile" class="form-label fw-semibold">@Loc.T("SelectPdfFile")</label>
                            <div class="custom-file-input-wrap" data-dnd-target="pdf">
                                <input asp-for="PdfFile" type="file" accept="application/pdf,.pdf"
                                       class="custom-file-input-native" id="pdfFileInput" required />
                                <label for="pdfFileInput" class="btn btn-outline-primary custom-file-input-btn"
                                       data-testid="upload-file-choose-btn">
                                    &#128206; @Loc.T("UploadFileChooseBtn")
                                </label>
                                <span class="custom-file-input-name" id="pdfFileName"
                                      data-empty-text="@Loc.T("UploadFileNoFileChosen")"
                                      data-testid="upload-file-name">
                                    @Loc.T("UploadFileNoFileChosen")
                                </span>
                                @* Small inline hint — visible only on desktop where drag-and-drop
                                   is meaningful. Progressive enhancement: if drag-drop.js fails to
                                   load, the hint still shows harmlessly (no functionality lost). *@
                                <span class="dnd-hint" data-testid="upload-dnd-hint">@Loc.T("DragDropHint")</span>
                            </div>
                            <div class="form-text">@Loc.T("MaxSizeHint")</div>
                            <span asp-validation-for="PdfFile" class="text-danger small"></span>
                        </div>

                        <!-- Submit button — placed directly under the upload box for
                             quicker "select file → interpret" flow (Feb 2026 UX tweak). -->
                        <button type="submit" class="btn btn-primary w-100 btn-lg mt-2" id="submitBtn">
                            @Loc.T("InterpretAndSend")
                        </button>

                        <div class="alert alert-warning small mt-3">
                            <i class="bi bi-info-circle"></i>
                            <strong>@Loc.T("ProcessingNoticeTitle")</strong><br />
                            @Loc.T("ProcessingNoticeBody")
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Account" asp-action="Dashboard" class="text-decoration-none small text-muted">
                    &larr; @Loc.T("BackToDashboard")
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================= -->
<!-- Full-screen processing overlay - shown on submit,              -->
<!-- automatically disappears when the server redirects (new page). -->
<!-- ============================================================= -->
<div id="processingOverlay" class="processing-overlay" aria-hidden="true" role="status" aria-live="polite">
    <div class="processing-box">
        <h3 class="processing-title">@Loc.T("PleaseWaitFewSeconds")</h3>
        @{
            var uploadMascotVd = new ViewDataDictionary(ViewData)
            {
                ["Mode"] = "waiting",
                ["Size"] = "medium",
                ["StageId"] = "uploadWaitMascot",
                ["TestId"] = "upload-wait-mascot"
            };
        }
        <partial name="_DoctorMascot" view-data="uploadMascotVd" />
        <p class="processing-subtitle" data-testid="upload-background-note">@Loc.T("InterpretationRunsInBackground")</p>

        <!-- Live progress: real stages + the results table as soon as it exists. -->
        <div class="progress-steps" id="progressSteps" data-testid="upload-progress-steps">
            <div class="progress-step" data-step="upload"><span class="dot"></span>@Loc.T("ProgressStepUpload")</div>
            <div class="progress-step" data-step="ai_extract"><span class="dot"></span>@Loc.T("ProgressStepExtract")</div>
            <div class="progress-step" data-step="ai_explain"><span class="dot"></span>@Loc.T("ProgressStepExplain")</div>
            <div class="progress-step" data-step="loinc_match"><span class="dot"></span>@Loc.T("ProgressStepLoinc")</div>
            <div class="progress-step" data-step="pdf_report"><span class="dot"></span>@Loc.T("ProgressStepPdf")</div>
        </div>
        <div class="progress-elapsed" id="progressElapsed" data-testid="upload-progress-elapsed"></div>

        <div id="progressError" class="alert alert-danger text-start mt-2" hidden
             data-testid="upload-progress-error"></div>

        <div class="mt-2">
            <a href="#" id="leaveInBackgroundLink" class="btn btn-outline-primary btn-sm"
               data-testid="leave-in-background-btn">@Loc.T("LeaveInBackgroundBtn")</a>
        </div>

        <div id="partialResults" class="partial-results" data-testid="upload-partial-results" hidden>
            <div class="partial-results-head">
                <span class="partial-badge" data-testid="upload-partial-badge">@Loc.T("ProgressPreliminaryTitle")</span>
                <span id="partialSummary" class="partial-summary" data-testid="upload-partial-summary"></span>
            </div>

            @* Each section stays hidden until the pipeline produces it, so the
               screen fills in progressively instead of all at once at the end. *@
            <div id="partialPatient" class="partial-section" data-testid="upload-partial-patient" hidden>
                <div class="partial-section-title">@Loc.T("ProgressSectionPatient")</div>
                <div id="partialPatientBody" class="partial-patient"></div>
            </div>

            <div id="partialTableSection" class="partial-section" data-testid="upload-partial-table-section" hidden>
                <div class="partial-section-title">@Loc.T("ProgressSectionAnalytes")</div>
                <div class="partial-table-wrap">
                    <table class="partial-table" data-testid="upload-partial-table">
                        <tbody id="partialTableBody"></tbody>
                    </table>
                </div>
            </div>

            <div id="partialFindings" class="partial-section" data-testid="upload-partial-findings" hidden>
                <div class="partial-section-title">@Loc.T("ProgressSectionOutOfRange")</div>
                <ul id="partialFindingsBody" class="partial-list"></ul>
            </div>

            <div id="partialNarrative" class="partial-section" data-testid="upload-partial-narrative" hidden>
                <div id="partialSummaryBlock" hidden>
                    <div class="partial-section-title">@Loc.T("ProgressSectionSummary")</div>
                    <p id="partialNarrativeSummary" class="partial-text"></p>
                </div>
                <div id="partialRecoBlock" hidden>
                    <div class="partial-section-title">@Loc.T("ProgressSectionRecommendations")</div>
                    <p id="partialNarrativeReco" class="partial-text"></p>
                </div>
            </div>

            <div id="partialPending" class="partial-pending" data-testid="upload-partial-pending">
                @Loc.T("ProgressSectionPending")
            </div>

            <p class="partial-note">@Loc.T("ProgressPreliminaryNote")</p>
        </div>
    </div>
</div>

<style>
    /* Hover & focus highlight for the "Pentru cine este analiza?" profile selector. */
    .profile-select-input {
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
        cursor: pointer;
    }
    .profile-select-input:hover {
        border-color: #0d6efd;
        background-color: #f0f7ff;
        box-shadow: 0 0 0 0.18rem rgba(13, 110, 253, 0.18);
    }
    .profile-select-input:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* === Custom localized file input (hides native "Choose File / No file chosen") ===
       Feb 2026: enlarged ~3× into a proper drop zone and made the empty-state
       placeholder red so it functions as a visible "you haven't picked anything"
       warning. Once a file IS selected, the filename displays in normal accent
       colour (see .has-file). */
    .custom-file-input-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
        padding: 32px 20px;
        min-height: 140px;                 /* ≈ 3× the previous ~48px */
        border: 2px dashed #ced4da;        /* dashed to signal "drop here" affordance */
        border-radius: 10px;
        background-color: #fff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease,
                    background-color 0.2s ease;
    }
    .custom-file-input-wrap:hover {
        border-color: #0d6efd;
        background-color: #f8fbff;
        box-shadow: 0 0 0 0.18rem rgba(13, 110, 253, 0.10);
    }
    .custom-file-input-wrap:focus-within {
        border-color: #0d6efd;
        border-style: solid;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    /* Hide the native input but keep it accessible & required-validatable. */
    .custom-file-input-native {
        position: absolute !important;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
        opacity: 0;
    }
    .custom-file-input-btn {
        margin-bottom: 0;
        cursor: pointer;
        white-space: nowrap;
        font-weight: 600;
    }
    /* Empty-state placeholder ("Niciun fișier selectat") — red bold single-line
       so the user can't miss that no file has been picked yet. */
    .custom-file-input-name {
        flex: 0 1 auto;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 0.95rem;
        color: #dc3545;                    /* Bootstrap danger */
        font-weight: 600;
    }
    /* File chosen → switch to informative accent colour, not a warning. */
    .custom-file-input-name.has-file {
        color: #0d47a1;
        font-weight: 500;
    }

    .processing-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 2000;
        background: rgba(13, 71, 161, 0.85);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.25s ease-out;
    }

        .processing-overlay.is-visible {
            display: flex;
        }

    .processing-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 40px 48px;
        text-align: center;
        max-width: 680px;
        width: calc(100% - 40px);
        max-height: 88vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    }

    /* ---- Live progress steps ---- */
    .progress-steps {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 22px auto 6px;
        text-align: left;
        max-width: 340px;
    }

    .progress-step {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.92rem;
        color: #90a4ae;
        transition: color 0.25s ease;
    }

        .progress-step .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #cfd8dc;
            flex: 0 0 auto;
            transition: background-color 0.25s ease, box-shadow 0.25s ease;
        }

        .progress-step.is-active {
            color: #0d47a1;
            font-weight: 600;
        }

            .progress-step.is-active .dot {
                background: #1976d2;
                box-shadow: 0 0 0 4px rgba(25, 118, 210, 0.18);
                animation: pulseDot 1.1s ease-in-out infinite;
            }

        .progress-step.is-done {
            color: #2e7d32;
        }

            .progress-step.is-done .dot {
                background: #2e7d32;
            }

    @@keyframes pulseDot {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.35); }
    }

    .progress-elapsed {
        font-size: 0.8rem;
        color: #90a4ae;
        margin-bottom: 4px;
    }

    /* ---- Preliminary results table ---- */
    .partial-results {
        margin-top: 18px;
        border-top: 1px solid #eceff1;
        padding-top: 14px;
        text-align: left;
        animation: fadeIn 0.35s ease;
    }

    .partial-results-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

    .partial-badge {
        background: #e8f5e9;
        color: #2e7d32;
        border-radius: 999px;
        padding: 3px 12px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .partial-summary {
        font-size: 0.82rem;
        color: #546e7a;
    }

    /* ---- Cabinet Medical: searchable patient picker ---- */
    .patient-picker {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
    }

    .patient-picker-list {
        position: absolute;
        z-index: 1060;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        max-height: 280px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #cfd8dc;
        border-radius: 10px;
        box-shadow: 0 14px 34px rgba(13, 71, 161, 0.16);
    }

    .patient-picker-item {
        display: block;
        width: 100%;
        text-align: left;
        border: 0;
        background: none;
        padding: 9px 14px;
        font-size: 0.95rem;
        color: #263238;
    }

        .patient-picker-item:hover,
        .patient-picker-item.is-active {
            background: #e8f1ff;
            color: #0d47a1;
        }

    .patient-picker-empty {
        padding: 10px 14px;
        font-size: 0.88rem;
        color: #78909c;
    }

    .partial-table-wrap {
        max-height: 26vh;
        overflow-y: auto;
        border: 1px solid #eceff1;
        border-radius: 10px;
    }

    /* ---- Progressive sections (patient / analytes / out of range / narrative) ---- */
    .partial-section {
        margin-top: 14px;
        animation: fadeIn 0.35s ease;
    }

    .partial-section-title {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #0d47a1;
        margin-bottom: 6px;
    }

    .partial-patient {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 10px;
        font-size: 0.82rem;
        color: #37474f;
    }

        .partial-patient span {
            background: #f1f6ff;
            border-radius: 8px;
            padding: 3px 9px;
        }

    .partial-list {
        margin: 0;
        padding-left: 18px;
        font-size: 0.82rem;
        color: #37474f;
    }

        .partial-list li {
            margin-bottom: 3px;
        }

        .partial-list li.is-high { color: #c62828; }
        .partial-list li.is-low { color: #1565c0; }

    .partial-text {
        font-size: 0.84rem;
        color: #37474f;
        line-height: 1.5;
        margin: 0 0 6px;
        white-space: pre-line;
    }

    .partial-pending {
        margin-top: 12px;
        font-size: 0.78rem;
        color: #1976d2;
        font-style: italic;
    }

    .partial-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82rem;
    }

        .partial-table td {
            padding: 5px 10px;
            border-bottom: 1px solid #f5f5f5;
        }

        .partial-table tr.is-out td {
            background: #fff8e1;
            font-weight: 600;
        }

        .partial-table td.val {
            text-align: right;
            white-space: nowrap;
        }

        .partial-table td.ref {
            color: #90a4ae;
            white-space: nowrap;
        }

    .partial-note {
        font-size: 0.76rem;
        color: #90a4ae;
        margin: 8px 0 0;
    }

    .processing-title {
        color: #0d47a1;
        font-weight: 700;
        margin: 0 0 12px 0;
        font-size: 1.5rem;
    }

    .processing-subtitle {
        color: #546e7a;
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>

@section Scripts {
    <script>
        // === Custom file input — update visible filename on selection ===
        (function () {
            var input = document.getElementById('pdfFileInput');
            var nameEl = document.getElementById('pdfFileName');
            if (!input || !nameEl) return;
            var emptyText = nameEl.getAttribute('data-empty-text') || '';
            // Localized native "required" validation message (replaces the
            // browser-default "Please select a file." which always renders
            // in English on Chromium/Edge regardless of the page language).
            var requiredMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("UploadFilePleaseSelect")));
            input.addEventListener('invalid', function () {
                input.setCustomValidity(requiredMsg);
            });
            input.addEventListener('change', function () {
                input.setCustomValidity(''); // clear any previous custom message
                if (input.files && input.files.length > 0) {
                    nameEl.textContent = input.files[0].name;
                    nameEl.classList.add('has-file');
                } else {
                    nameEl.textContent = emptyText;
                    nameEl.classList.remove('has-file');
                }
            });
        })();
    </script>

    <script>
        (function () {
            var form = document.getElementById('uploadForm');
            var btn = document.getElementById('submitBtn');
            var overlay = document.getElementById('processingOverlay');
            if (!form || !overlay) return;

            form.addEventListener('submit', function (e) {
                // Let browser validation (required file) run first.
                if (!form.checkValidity()) return;

                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '@Loc.T("ProcessingPleaseWait")';
                }
                overlay.classList.add('is-visible');
                overlay.setAttribute('aria-hidden', 'false');
                startProgressPolling();
            });

            // ---------------------------------------------------------------
            // Live progress: ask the server what it is doing and show the table
            // of results as soon as the extraction stage produces it, instead of
            // making the user stare at a spinner for the whole pipeline.
            // ---------------------------------------------------------------
            var STAGES = ['upload', 'ai_extract', 'ai_explain', 'loinc_match', 'pdf_report'];
            var tokenEl = document.getElementById('progressToken');
            // When the POST comes back, the server hands us the token of the job it
            // just queued so we keep following THAT job instead of inventing a new one.
            var serverToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                (ViewBag.ActiveProgressToken as string) ?? ""));
            var token = serverToken
                || ((window.crypto && window.crypto.randomUUID)
                    ? window.crypto.randomUUID()
                    : 'p' + Date.now() + Math.random().toString(36).slice(2));
            if (tokenEl) tokenEl.value = token;

            // "Lasă în fundal" → the profile's archive, where the row shows "în lucru".
            var bgLink = document.getElementById('leaveInBackgroundLink');
            function backgroundHref() {
                var sel = document.querySelector('[name="ProfileId"]');
                var pid = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    ViewBag.ActiveProfileId as int? ?? 0));
                if (!pid && sel && sel.value) pid = parseInt(sel.value, 10) || 0;
                return pid ? ('/Profiles/History/' + pid) : '/Profiles';
            }
            if (bgLink) bgLink.addEventListener('click', function (e) {
                e.preventDefault();
                window.location.href = backgroundHref();
            });

            // ---- Cabinet Medical: searchable patient picker ----------------
            // Queries the server (max 20 matches) instead of shipping 2000 names
            // to the browser. Only rendered for CM accounts.
            (function () {
                var input = document.getElementById('patientPickerInput');
                var hidden = document.getElementById('patientPickerId');
                var list = document.getElementById('patientPickerList');
                if (!input || !hidden || !list) return;

                var NO_RESULTS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("InterpretPatientSearchNoResults")));
                var timer = null;
                var items = [];
                var activeIndex = -1;

                function close() {
                    list.classList.add('d-none');
                    input.setAttribute('aria-expanded', 'false');
                    activeIndex = -1;
                }

                function pick(item) {
                    hidden.value = item.id;
                    input.value = item.name;
                    close();
                }

                function render() {
                    if (!items.length) {
                        list.innerHTML = '<div class="patient-picker-empty">' + escapeHtml(NO_RESULTS) + '</div>';
                    } else {
                        list.innerHTML = items.map(function (it, i) {
                            return '<button type="button" class="patient-picker-item" data-index="' + i + '">'
                                 + escapeHtml(it.name) + '</button>';
                        }).join('');
                    }
                    list.classList.remove('d-none');
                    input.setAttribute('aria-expanded', 'true');
                }

                function search() {
                    fetch('/Interpretation/SearchProfiles?q=' + encodeURIComponent(input.value.trim()), {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                        .then(function (r) { return r.ok ? r.json() : []; })
                        .then(function (data) {
                            items = data || [];
                            activeIndex = -1;
                            render();
                        })
                        .catch(function () { close(); });
                }

                input.addEventListener('input', function () {
                    // Typing invalidates the previous choice, so the form cannot
                    // submit a patient the doctor no longer sees on screen.
                    hidden.value = '';
                    clearTimeout(timer);
                    timer = setTimeout(search, 250);
                });

                input.addEventListener('focus', function () {
                    if (!list.classList.contains('d-none')) return;
                    clearTimeout(timer);
                    timer = setTimeout(search, 80);
                });

                input.addEventListener('keydown', function (e) {
                    if (list.classList.contains('d-none')) return;
                    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                        e.preventDefault();
                        if (!items.length) return;
                        activeIndex = e.key === 'ArrowDown'
                            ? Math.min(activeIndex + 1, items.length - 1)
                            : Math.max(activeIndex - 1, 0);
                        var buttons = list.querySelectorAll('.patient-picker-item');
                        for (var i = 0; i < buttons.length; i++) {
                            buttons[i].classList.toggle('is-active', i === activeIndex);
                        }
                    } else if (e.key === 'Enter') {
                        if (items.length) {
                            e.preventDefault();
                            pick(items[activeIndex >= 0 ? activeIndex : 0]);
                        }
                    } else if (e.key === 'Escape') {
                        close();
                    }
                });

                list.addEventListener('click', function (e) {
                    var btn = e.target.closest('.patient-picker-item');
                    if (!btn) return;
                    pick(items[parseInt(btn.getAttribute('data-index'), 10)]);
                });

                document.addEventListener('click', function (e) {
                    if (!e.target.closest('.patient-picker')) close();
                });
            })();

            function paintStage(stage) {
                var idx = STAGES.indexOf(stage);
                if (stage === 'done') idx = STAGES.length;
                if (idx < 0) return;
                document.querySelectorAll('#progressSteps .progress-step').forEach(function (el) {
                    var i = STAGES.indexOf(el.getAttribute('data-step'));
                    el.classList.toggle('is-done', i < idx);
                    el.classList.toggle('is-active', i === idx);
                });
            }

            // ---- Progressive rendering ------------------------------------
            // Each section is painted the moment the server has it, and repainted
            // only when its content actually changed (the poll runs every 1.5 s).
            var lastPaint = { table: '', patient: '', findings: '', narrative: '' };

            function revealBox() {
                var box = document.getElementById('partialResults');
                if (box && box.hidden) box.hidden = false;
            }

            function show(id) {
                var el = document.getElementById(id);
                if (el && el.hidden) el.hidden = false;
            }

            function paintTable(rows, outOfRange) {
                var body = document.getElementById('partialTableBody');
                if (!body || !rows || !rows.length) return;

                var sig = JSON.stringify(rows);
                if (sig === lastPaint.table) return;
                lastPaint.table = sig;

                var html = '';
                for (var i = 0; i < rows.length; i++) {
                    var r = rows[i];
                    var out = (r.status === 'high' || r.status === 'low' || r.status === 'borderline');
                    var arrow = r.status === 'high' ? ' ▲' : (r.status === 'low' ? ' ▼' : '');
                    html += '<tr class="' + (out ? 'is-out' : '') + '">'
                          + '<td>' + escapeHtml(r.parameter || '') + '</td>'
                          + '<td class="val">' + escapeHtml(r.value || '') + ' ' + escapeHtml(r.unit || '') + arrow + '</td>'
                          + '<td class="ref">' + escapeHtml(r.referenceRange || '') + '</td>'
                          + '</tr>';
                }
                body.innerHTML = html;

                var summary = document.getElementById('partialSummary');
                if (summary) {
                    summary.textContent = '@Loc.T("ProgressPreliminarySummary")'
                        .replace('{0}', rows.length)
                        .replace('{1}', outOfRange || 0);
                }
                revealBox();
                show('partialTableSection');
            }

            function paintPatient(p) {
                if (!p) return;
                var sig = JSON.stringify(p);
                if (sig === lastPaint.patient) return;
                lastPaint.patient = sig;

                var parts = [
                    [@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("PatientName"))), p.name],
                    [@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("PatientAge"))), p.age],
                    [@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("PatientSex"))), p.sex],
                    [@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("DateTaken"))), p.dateTaken],
                    [@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("Laboratory"))), p.laboratory]
                ];
                var html = '';
                for (var i = 0; i < parts.length; i++) {
                    if (!parts[i][1]) continue;
                    html += '<span><strong>' + escapeHtml(parts[i][0]) + ':</strong> '
                          + escapeHtml(parts[i][1]) + '</span>';
                }
                if (!html) return;

                document.getElementById('partialPatientBody').innerHTML = html;
                revealBox();
                show('partialPatient');
            }

            // "Out of range" = the flagged rows of the table, plus anything the
            // model listed as an abnormal finding but did not flag in the table.
            function paintFindings(rows, findings) {
                var out = [];
                var seen = {};
                (rows || []).forEach(function (r) {
                    if (r.status === 'high' || r.status === 'low' || r.status === 'borderline') {
                        seen[(r.parameter || '').toLowerCase()] = true;
                        out.push({
                            text: (r.parameter || '') + ': ' + (r.value || '') + ' ' + (r.unit || ''),
                            status: r.status
                        });
                    }
                });
                (findings || []).forEach(function (f) {
                    var name = (f.parameter || '');
                    if (!name || seen[name.toLowerCase()]) return;
                    out.push({ text: name, status: '' });
                });
                if (!out.length) return;

                var sig = JSON.stringify(out);
                if (sig === lastPaint.findings) return;
                lastPaint.findings = sig;

                var html = '';
                for (var i = 0; i < out.length; i++) {
                    var cls = out[i].status === 'high' ? 'is-high'
                            : (out[i].status === 'low' ? 'is-low' : '');
                    html += '<li class="' + cls + '">' + escapeHtml(out[i].text.trim()) + '</li>';
                }
                document.getElementById('partialFindingsBody').innerHTML = html;
                revealBox();
                show('partialFindings');
            }

            function paintNarrative(summaryText, recoText) {
                var sig = (summaryText || '') + '|' + (recoText || '');
                if (sig === '|' || sig === lastPaint.narrative) return;
                lastPaint.narrative = sig;

                if (summaryText) {
                    document.getElementById('partialNarrativeSummary').textContent = summaryText;
                    show('partialSummaryBlock');
                }
                if (recoText) {
                    document.getElementById('partialNarrativeReco').textContent = recoText;
                    show('partialRecoBlock');
                }
                revealBox();
                show('partialNarrative');
            }

            function paintPartials(d) {
                if (d.table && d.table.length) {
                    paintTable(d.table, d.outOfRange);
                    paintFindings(d.table, d.findings);
                }
                paintPatient(d.patient);
                paintNarrative(d.summary, d.recommendations);

                // Hide the "still being written" line once the narrative landed.
                var pending = document.getElementById('partialPending');
                if (pending && d.recommendations) pending.hidden = true;
            }

            function escapeHtml(s) {
                return String(s).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }

            function startProgressPolling() {
                var started = Date.now();
                var elapsedEl = document.getElementById('progressElapsed');
                var errEl = document.getElementById('progressError');
                paintStage('upload');

                var elapsedTimer = setInterval(function () {
                    if (elapsedEl) {
                        var s = Math.round((Date.now() - started) / 1000);
                        elapsedEl.textContent = '@Loc.T("ProgressElapsed")'.replace('{0}', s);
                    }
                }, 1000);

                var pollTimer = setInterval(function () {
                    fetch('@Url.Action("Progress", "Interpretation")?token=' + encodeURIComponent(token),
                          { credentials: 'same-origin' })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (d) {
                            if (!d) return;
                            paintStage(d.stage);
                            paintPartials(d);

                            if (d.stage === 'done' && d.redirectUrl) {
                                clearInterval(pollTimer);
                                clearInterval(elapsedTimer);
                                try {
                                    if (window.DoctorMascot &&
                                        window.DoctorMascot.playInterpretationFinishSound) {
                                        window.DoctorMascot.playInterpretationFinishSound();
                                    }
                                } catch (e) { /* sound is a nicety */ }
                                window.location.href = d.redirectUrl;
                                return;
                            }

                            if (d.stage === 'error') {
                                clearInterval(pollTimer);
                                clearInterval(elapsedTimer);
                                if (errEl) {
                                    errEl.textContent = d.error || '';
                                    errEl.hidden = false;
                                }
                                if (btn) {
                                    btn.disabled = false;
                                    btn.innerHTML = '@Loc.T("InterpretAndSend")';
                                }
                            }
                        })
                        .catch(function () { /* polling is best-effort */ });
                }, 1500);
            }

            // The POST returns immediately now (the job runs in the background),
            // so when the server hands us a token we re-open the overlay and keep
            // watching the job that is already running.
            if (serverToken) {
                overlay.classList.add('is-visible');
                overlay.setAttribute('aria-hidden', 'false');
                startProgressPolling();
            }

            // Safety net: if user navigates back via bfcache and the page is
            // restored from cache with the overlay still visible, hide it.
            window.addEventListener('pageshow', function (ev) {
                if (ev.persisted) {
                    overlay.classList.remove('is-visible');
                    overlay.setAttribute('aria-hidden', 'true');
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = '@Loc.T("InterpretAndSend")';
                    }
                }
            });
        })();
    </script>
}
