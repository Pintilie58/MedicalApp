@model MedicalApp.Models.CompareInterpretationsViewModel
@{
    ViewData["Title"] = string.Format(MedicalApp.Services.Loc.T("CompareViewTabTitle"), Model.ProfileName);

    string CellClass(string d) => d switch
    {
        "first"     => "table-light",
        "risen"     => "table-danger",
        "fallen"    => "table-info",
        "unchanged" => "",
        "absent"    => "table-warning text-muted fst-italic",
        _ => ""
    };
    string CellIcon(string d) => d switch
    {
        "risen"     => "<span style=\"color:#dc3545;font-weight:600;\">&#8599;</span>",   // ↗ roșu
        "fallen"    => "<span style=\"color:#0d6efd;font-weight:600;\">&#8600;</span>",   // ↘ albastru
        "unchanged" => "",
        "first"     => "",
        "absent"    => "<span class=\"text-muted\">&mdash;</span>",
        _ => ""
    };
    string StatusBadge(string? status) => status?.ToLowerInvariant() switch
    {
        "high"       => "<span class=\"badge bg-danger\">&#8593;</span>",
        "low"        => "<span class=\"badge bg-primary\">&#8595;</span>",
        "borderline" => "<span class=\"badge bg-warning text-dark\">&#8776;</span>",
        "normal"     => "<span class=\"badge bg-success\">&#10003;</span>",
        _ => ""
    };
}

<style>
    /* ---- Header ---- */
    .cmp-brand { text-align: center; color: #0d47a1; font-weight: 800; font-size: 1.05rem; letter-spacing: .02em; margin-bottom: .35rem; }
    .cmp-brand::after { content: ""; display: block; height: 2px; background: #0d47a1; opacity: .85; margin: .45rem auto 0; max-width: 14rem; }
    .cmp-title { color: #0d47a1; font-weight: 700; font-size: 1.35rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem; }
    .cmp-title-main { font-weight: 800; }
    .cmp-title-sep { color: #9aa3ad; font-weight: 400; }
    .cmp-title-part { font-size: 1.05rem; font-weight: 600; color: #212529; }
    .cmp-title-label { color: #6c757d; font-weight: 500; }

    /* ---- Interpretation cards: one row, equal widths ---- */
    .cmp-cols { display: flex; flex-wrap: wrap; gap: .5rem; }
    .cmp-col-card {
        flex: 1 1 0; min-width: 9.5rem;
        background: #fff; border: 1px solid #e3e8ee; border-top: 3px solid #0d6efd; border-radius: .45rem;
        padding: .45rem .7rem .5rem; line-height: 1.25;
    }
    .cmp-col-idx { font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; color: #8a9099; font-weight: 600; }
    .cmp-col-date { font-size: 1.05rem; font-weight: 800; color: #212529; margin: .05rem 0 .15rem; }
    .cmp-col-meta { font-size: .76rem; color: #495057; }
    .cmp-col-faint { color: #9aa3ad; }

    /* ---- Table (desktop): compact cells, sticky header, zebra rows ---- */
    .compare-table { table-layout: auto; font-size: .92rem; }
    .compare-table thead th { position: sticky; top: 0; z-index: 2; font-size: .8rem; padding: .45rem .5rem; box-shadow: inset 0 -1px 0 #dee2e6; }
    .compare-table thead th.cmp-th-param { width: 28%; min-width: 11rem; }
    .compare-table thead th.cmp-th-ref { width: 14%; min-width: 6.5rem; }
    .compare-table thead th.cmp-th-date { min-width: 6rem; white-space: nowrap; }
    .compare-table > tbody > tr > td { padding: .4rem .5rem; }
    .compare-table > tbody > tr:nth-child(even):not(.table-secondary) > td { --bs-table-bg: #fafbfd; }
    .compare-table td.cmp-label { font-size: .92rem; line-height: 1.3; }
    .compare-table td.cmp-label .badge { font-size: .66rem; padding: .2em .4em; }
    .compare-table td.cmp-cell { white-space: nowrap; }
    .compare-table .cmp-val { display: inline-flex; align-items: center; gap: .3rem; }
    .compare-table .cmp-val .badge { font-size: .62rem; padding: .22em .38em; line-height: 1; }
    .compare-table td.cmp-ref { font-size: .8rem; }

    @@media (max-width: 991.98px) {
        .compare-table { font-size: clamp(.78rem, 1.7vw, .9rem); }
        .compare-table thead th { font-size: clamp(.7rem, 1.5vw, .8rem); }
        .compare-table thead th.cmp-th-param { min-width: 9rem; }
        .compare-table thead th.cmp-th-date { min-width: 5rem; }
        .cmp-title { font-size: 1.15rem; }
        .cmp-title-part { font-size: .95rem; }
    }
    /* Card mode (toggled by the script under the table once the window is narrower
       than the threshold for the number of selected interpretations): one card per
       analyte — name on top, then one dated chip per interpretation (equal widths,
       no empty space on the right), then the reference range. No horizontal scrolling. */
    .compare-table.cmp-cards thead { display: none; }
    .compare-table.cmp-cards, .compare-table.cmp-cards tbody, .compare-table.cmp-cards tr, .compare-table.cmp-cards td { display: block; }
    .compare-table.cmp-cards > tbody > tr { display: flex; flex-wrap: wrap; gap: .35rem; padding: .6rem 0 .7rem; border-top: 1px solid #e9ecef; }
    .compare-table.cmp-cards > tbody > tr > td { border: 0; padding: 0; box-shadow: none; --bs-table-bg: transparent; }
    .compare-table.cmp-cards > tbody > tr.table-secondary { display: block; padding: 0; margin-top: .75rem; }
    .compare-table.cmp-cards > tbody > tr.table-secondary > td { display: block; padding: .45rem .6rem; border-radius: .35rem; }
    .compare-table.cmp-cards td.cmp-label { flex: 1 1 100%; font-size: .95rem; }
    .compare-table.cmp-cards td.cmp-cell {
        flex: 1 1 0; min-width: 5.5rem;
        text-align: left !important;
        padding: .25rem .55rem !important;
        border: 1px solid #e3e8ee;
        border-radius: .35rem;
        font-size: .86rem;
        white-space: normal;
    }
    .compare-table.cmp-cards td.cmp-cell::before {
        content: attr(data-label);
        display: block;
        font-size: .62rem;
        line-height: 1.2;
        color: #8a9099;
        font-weight: 600;
        letter-spacing: .02em;
    }
    .compare-table.cmp-cards td.cmp-ref { flex: 1 1 100%; margin-top: .15rem; }
    .compare-table.cmp-cards td.cmp-ref::before { content: attr(data-label) ": "; font-weight: 600; text-transform: uppercase; font-size: .62rem; letter-spacing: .03em; }
</style>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xxl-11">
            <div class="cmp-brand" data-testid="compare-brand">www.MyMedicalApp.net</div>
            <div class="d-flex align-items-center mb-3 flex-wrap gap-2">
                <h2 class="cmp-title mb-0" data-testid="compare-heading">
                    <span class="cmp-title-main">&#128200; @Loc.T("CompareHeaderTitle")</span>
                    @if (!string.IsNullOrWhiteSpace(Model.UserLabel))
                    {
                        <span class="cmp-title-sep">—</span>
                        <span class="cmp-title-part"><span class="cmp-title-label">@Loc.T("CompareHeaderUser"):</span> <span data-testid="compare-heading-user">@Model.UserLabel</span></span>
                        <span class="cmp-title-sep">·</span>
                    }
                    else
                    {
                        <span class="cmp-title-sep">—</span>
                    }
                    <span class="cmp-title-part"><span class="cmp-title-label">@Loc.T("CompareHeaderProfile"):</span> <span data-testid="compare-heading-profile">@Model.ProfileName</span></span>
                </h2>
                <span class="badge bg-secondary align-self-center" data-testid="compare-column-count">
                    @string.Format(Loc.T("ProfileCompareInterpretationsCount"), Model.Columns.Count)
                </span>
                <div class="ms-auto d-flex gap-2 flex-wrap">
                    @if (Model.Columns.Count >= CompareInterpretationsViewModel.MinSelections)
                    {
                        <button type="button" id="btnCompareExportDownload"
                                class="btn btn-outline-primary"
                                data-testid="btn-compare-export-download">
                            &#128229; @Loc.T("CompareViewDownloadPdf")
                        </button>
                        <button type="button" id="btnCompareExportEmail"
                                class="btn btn-outline-success"
                                data-testid="btn-compare-export-email">
                            &#9993; @Loc.T("CompareViewSendEmail")
                        </button>
                    }
                    <a asp-action="History" asp-route-id="@Model.ProfileId"
                       class="btn btn-outline-secondary" data-testid="btn-back-history">
                        &larr; @Loc.T("CompareViewBackToArchive")
                    </a>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" data-testid="compare-success">
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" data-testid="compare-error">
                    @TempData["ErrorMessage"]
                </div>
            }

            @if (Model.CreditConsumed)
            {
                <div class="alert alert-warning" data-testid="compare-credit-consumed-msg">
                    &#128181; @Loc.T("CompareViewCreditConsumed")
                </div>
            }

            <p class="text-muted small mb-3">
                @Loc.T("ProfileCompareColumnOrderHint")
            </p>

            @* Column headers as compact cards — always one row (2–6 equal cards) *@
            <div class="cmp-cols mb-3">
                @{
                    var colorByIdx = new[] { "#0d6efd", "#0dcaf0", "#ffc107", "#198754", "#6f42c1", "#fd7e14" };
                }
                @for (int i = 0; i < Model.Columns.Count; i++)
                {
                    var col = Model.Columns[i];
                    var accent = colorByIdx[i % colorByIdx.Length];
                    <div class="cmp-col-card" style="border-top-color:@accent" data-testid="compare-col-card-@i">
                        <div class="cmp-col-idx">@string.Format(Loc.T("ProfileCompareInterpretationN"), i + 1)</div>
                        <div class="cmp-col-date" data-testid="compare-col-sampled-@i" title="@Loc.T("ProfileCompareSamplingLabel")">
                            @col.EffectiveDate.ToLocalTime().ToString("yyyy-MM-dd")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(col.PatientName))
                        {
                            <div class="cmp-col-meta text-truncate" data-testid="compare-col-patient-@i"
                                 title="@Loc.T("CompareViewPatientTooltip")">
                                <span class="text-muted">@Loc.T("ProfileComparePatientLabel")</span> <strong>@col.PatientName</strong>
                            </div>
                        }
                        <div class="cmp-col-meta">
                            @string.Format(Loc.T("ProfileCompareParamsAbnormalFormat"), col.KeyResultsCount, col.AbnormalFindingsCount)
                        </div>
                        <div class="cmp-col-meta cmp-col-faint">
                            @Loc.T("ProfileCompareInterpretedLabel") @col.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3" data-testid="compare-summary-badges">
                <span class="badge bg-danger">@string.Format(Loc.T("ProfileCompareBadgeRisen"), Model.RisenCount)</span>
                <span class="badge bg-info text-dark">@string.Format(Loc.T("ProfileCompareBadgeFallen"), Model.FallenCount)</span>
                <span class="badge bg-success">@string.Format(Loc.T("ProfileCompareBadgeUnchanged"), Model.UnchangedCount)</span>
                @if (Model.PartialCount > 0)
                {
                    <span class="badge bg-warning text-dark" data-testid="compare-partial-badge">
                        @string.Format(Loc.T("ProfileCompareBadgePartial"), Model.PartialCount)
                    </span>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle compare-table" data-testid="compare-table"
                       data-cards-below="@(Model.Columns.Count switch { <= 2 => 576, <= 4 => 768, _ => 992 })">
                    <thead class="table-light">
                        <tr>
                            <th class="cmp-th-param">@Loc.T("ProfileCompareHeaderParameter")</th>
                            @for (int i = 0; i < Model.Columns.Count; i++)
                            {
                                var col = Model.Columns[i];
                                <th class="text-center cmp-th-date">
                                    @col.EffectiveDate.ToLocalTime().ToString("yyyy-MM-dd")
                                </th>
                            }
                            <th class="text-muted small cmp-th-ref">@Loc.T("ProfileCompareHeaderReference")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            @if (row.IsFirstInClass)
                            {
                                <tr class="table-secondary" data-testid="compare-class-header-@row.LoincClass">
                                    <td colspan="@(Model.Columns.Count + 2)"
                                        class="fw-bold text-uppercase small text-dark py-2"
                                        style="letter-spacing:.04em; background:#eef3ff;">
                                        &#129516; @row.ClassDisplayLabel
                                        @if (!string.IsNullOrWhiteSpace(row.LoincClass))
                                        {
                                            <span class="badge bg-light text-secondary border ms-2 small fw-normal"
                                                  title="@Loc.T("CompareViewLoincClassTooltip")">
                                                @row.LoincClass
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                            <tr data-testid="compare-row-@row.Parameter.Replace(" ", "-")">
                                <td class="fw-semibold cmp-label" data-testid="compare-row-label">
                                    @row.Parameter
                                    @if (!string.IsNullOrWhiteSpace(row.Unit))
                                    { <span class="small text-muted">(@row.Unit)</span> }
                                    @if (!string.IsNullOrEmpty(row.MissingAxis))
                                    {
                                        <span class="ms-1 text-muted"
                                              style="cursor:help;font-weight:700;"
                                              title="@Loc.T(row.MissingAxis == "both" ? "LoincUnifyMissingBothTip" : row.MissingAxis == "unit" ? "LoincUnifyMissingUnitTip" : "LoincUnifyMissingRangeTip")"
                                              data-testid="compare-row-unify-warning">!</span>
                                    }
                                    @if (row.HasLoincDrift)
                                    {
                                        <span class="ms-1"
                                              style="color:#fd7e14;cursor:help;font-weight:700;"
                                              title="@string.Format(Loc.T("CompareViewDriftWarningTooltip"), row.Parameter, row.LoincCode, string.Join(", ", row.DriftLoincCodes))"
                                              data-testid="compare-row-drift-warning">&#9888;</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row.LoincCode))
                                    {
                                        <span class="badge bg-light text-secondary border ms-1 small"
                                              title="@row.LoincLongName"
                                              data-testid="compare-row-loinc-@row.LoincCode">
                                            LOINC @row.LoincCode
                                        </span>
                                        <span class="d-inline-block rounded-circle ms-1"
                                              style="width:9px;height:9px;background:@MedicalApp.Services.LoincSourceBadge.GetDotColor(row.LoincSource);vertical-align:middle;"
                                              title="@MedicalApp.Services.LoincSourceBadge.GetTooltip(row.LoincSource)"
                                              data-testid="compare-row-source-@row.LoincSource">
                                        </span>
                                        @if (!MedicalApp.Services.LoincSourceBadge.IsVerified(row.LoincSource) && row.LoincScore.HasValue)
                                        {
                                            <span class="small text-muted ms-1"
                                                  data-testid="compare-row-score">@((int)Math.Round(row.LoincScore.Value * 100))%</span>
                                        }
                                    }
                                </td>
                                @for (int ci = 0; ci < row.Cells.Count; ci++)
                                {
                                    var cell = row.Cells[ci];
                                    var cellDate = ci < Model.Columns.Count ? Model.Columns[ci].EffectiveDate.ToLocalTime().ToString("yyyy-MM-dd") : "";
                                    <td class="text-center cmp-cell @CellClass(cell.CellDirection)" data-label="@cellDate">
                                        @if (cell.CellDirection == "absent")
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            <span class="cmp-val">
                                                <span>@(cell.Value ?? "-")</span>
                                                @Html.Raw(StatusBadge(cell.Status))
                                                @Html.Raw(CellIcon(cell.CellDirection))
                                            </span>
                                        }
                                    </td>
                                }
                                <td class="small text-muted cmp-ref" data-label="@Loc.T("ProfileCompareHeaderReference")">@(row.ReferenceRange ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <script>
                (function () {
                    var t = document.querySelector('.compare-table');
                    if (!t) return;
                    var mq = window.matchMedia('(max-width: ' + (parseInt(t.getAttribute('data-cards-below'), 10) - 0.02) + 'px)');
                    function apply() { t.classList.toggle('cmp-cards', mq.matches); }
                    apply();
                    if (mq.addEventListener) mq.addEventListener('change', apply); else mq.addListener(apply);
                })();
            </script>

            <p class="small text-muted mt-3">
                @Loc.T("CompareViewLegendGrouping")
                <br />
                @Loc.T("CompareViewLegendColors")
                <br />
                <span class="d-inline-block rounded-circle" style="width:9px;height:9px;background:#198754;vertical-align:middle;"></span>
                @Loc.T("LoincSourceLegendVerified")
                &nbsp;·&nbsp;
                <span class="d-inline-block rounded-circle" style="width:9px;height:9px;background:#0d6efd;vertical-align:middle;"></span>
                @Loc.T("LoincSourceLegendAuto")
                &nbsp;·&nbsp;
                <span style="color:#fd7e14;font-weight:700;">&#9888;</span>
                @Loc.T("CompareViewLegendDrift")
            </p>
        </div>
    </div>
</div>

@if (Model.Columns.Count >= CompareInterpretationsViewModel.MinSelections)
{
    @* Hidden form used to POST to CompareExport. Anti-forgery token is
       auto-injected by the form tag helper. Mirrors Evolution's pattern. *@
    <form id="compareExportForm" asp-action="CompareExport" method="post" style="display:none;">
        <input type="hidden" name="ProfileId" value="@Model.ProfileId" />
        @foreach (var c in Model.Columns)
        {
            <input type="hidden" name="Ids" value="@c.HistoryId" />
        }
        <input type="hidden" name="Mode" id="compareExportMode" value="download" />
    </form>

    <script>
        (function () {
            var form    = document.getElementById('compareExportForm');
            var modeEl  = document.getElementById('compareExportMode');
            var btnDl   = document.getElementById('btnCompareExportDownload');
            var btnMail = document.getElementById('btnCompareExportEmail');

            function submitAs(mode) {
                if (!form || !modeEl) return;
                modeEl.value = mode;
                form.submit();
            }
            if (btnDl)   btnDl.addEventListener('click',   function () { submitAs('download'); });
            if (btnMail) btnMail.addEventListener('click', function () { submitAs('email'); });
        })();
    </script>
}
