@model MedicalApp.Models.ReportScreenViewModel
@using MedicalApp.Services
@{
    ViewData["Title"] = Loc.T("ScreenReportTitle");
    var buyUrl = Url.Action("Buy", "Credits");
    var freeWord = Loc.T("PdfFreemiumFreeWord");
    var lockedLabel = Loc.T("PdfFreemiumLockedLabel");

    // Highlights the localized "FREE" word in red inside an otherwise
    // HTML-encoded string (same visual language as the DEMO PDF).
    Func<string, string> hi = s =>
    {
        var enc = System.Net.WebUtility.HtmlEncode(s ?? "");
        var encWord = System.Net.WebUtility.HtmlEncode(freeWord);
        return string.IsNullOrWhiteSpace(freeWord)
            ? enc
            : enc.Replace(encWord, $"<span class=\"text-danger fw-bold\">{encWord}</span>");
    };

    // Same palette and arrows the PDF uses (PdfReportGenerator.StatusArrow),
    // so the on-screen report and the PDF read as one single document.
    Func<string?, (string Color, string Arrow, string Badge)> st = s => (s ?? "").ToLowerInvariant() switch
    {
        "high" => ("#c62828", "&#8593;", "bg-danger"),
        "low" => ("#1565c0", "&#8595;", "bg-primary"),
        "borderline" => ("#f9a825", "&#8776;", "bg-warning text-dark"),
        _ => ("#2e7d32", "&#10003;", "bg-success")
    };

    var visiblePct = Model.TotalResultsCount > 0
        ? (int)Math.Round(100.0 * Model.VisibleResultsCount / Model.TotalResultsCount)
        : 0;
}

<style>
    .report-stage {
        background: linear-gradient(180deg, #eef1f5 0%, #e7ebf0 100%);
        padding: 2.5rem 0 8rem;
    }
    .report-paper {
        position: relative;
        background: #fff;
        border-radius: .75rem;
        box-shadow: 0 1.5rem 3rem rgba(13, 71, 161, .10), 0 .25rem .5rem rgba(0, 0, 0, .05);
        padding: 2.75rem 3rem 3rem;
        overflow: hidden;
    }
    /* Faint diagonal DEMO watermark — only on the freemium version, mirrors the PDF. */
    .report-paper.demo-paper::before {
        content: "DEMO";
        position: absolute;
        top: 38%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-28deg);
        font-size: 11rem;
        font-weight: 800;
        letter-spacing: .1em;
        color: #eff1f4;
        pointer-events: none;
        user-select: none;
        z-index: 0;
    }
    .report-paper > * { position: relative; z-index: 1; }

    .brand-head { text-align: center; }
    .brand-head .brand-name {
        color: #0d47a1;
        font-weight: 800;
        font-size: 1.85rem;
        letter-spacing: -.01em;
    }
    .brand-head .brand-sub { color: #6c757d; font-size: .95rem; }
    .brand-head .brand-url { color: #0d47a1; font-size: .85rem; }
    .brand-rule { height: 2px; background: #0d47a1; margin: .9rem 0 0; opacity: .85; }

    .report-section-title {
        color: #0d47a1;
        font-weight: 700;
        border-bottom: 2px solid #0d47a1;
        padding-bottom: .35rem;
        margin: 2.4rem 0 1rem;
        font-size: 1.08rem;
    }

    .rt { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .rt thead th {
        color: #0d47a1;
        font-weight: 700;
        font-size: .84rem;
        border-bottom: 2px solid #dfe4ea;
        padding: .5rem .35rem;
        text-transform: none;
    }
    .rt tbody td {
        border-top: 1px solid #eceff3;
        padding: .7rem .35rem;
        /* Top-aligned so value / reference / status stay on the same line as the
           analyte name even when the explanation runs for many lines. */
        vertical-align: top;
        word-break: break-word;
    }
    .rt tbody tr:hover td { background: #f8fbff; }
    .rt .col-value { text-align: right; white-space: nowrap; padding-right: 1.5rem !important; }
    /* Reference ranges can be descriptive ("100-125: Glicemie bazala modificata"),
       so they must wrap inside their own column instead of spilling over Status. */
    .rt .col-ref { text-align: left; padding-left: 1.5rem !important; color: #6c757d; overflow-wrap: anywhere; }
    .rt .col-status { text-align: center; }
    .param-name { font-size: 1.05rem; font-weight: 700; line-height: 1.3; }
    .rt tr.panel-row td {
        background: #f4f7fb;
        color: #0d47a1;
        font-style: italic;
        font-weight: 600;
        font-size: .84rem;
        padding: .45rem .35rem;
    }
    .rt tr.locked-row td { background: #f7f8f9; }
    .rt tr.has-ref-note td { border-bottom: 0; }
    /* Full-width detail row (explanation + LOINC) under the compact main row. */
    .rt tr.rt-main td { vertical-align: middle; }
    .rt tr.rt-detail td.rt-detail-cell { border-top: 0; padding: 0 .35rem .7rem; }
    .rt tr.rt-main.has-detail td, .rt tr.rt-main.has-ref-note td { padding-bottom: .3rem; }
    .rt tr.rt-detail:hover td { background: transparent; }
    .rt tr.rt-detail .explain { margin-top: 0; }
    .rt tr.locked-row.rt-detail td { background: #f7f8f9; }
    .rt tr.ref-note-row td.ref-note {
        border-top: 0; padding: 0 .35rem .7rem; font-size: .78rem; line-height: 1.45; color: #5c6670; overflow-wrap: anywhere;
    }
    .rt tr.ref-note-row:hover td { background: transparent; }
    .ref-note-label { font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; color: #8a9099; margin-right: .2rem; }

    .status-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.9rem;
        height: 1.9rem;
        border-radius: 50%;
        color: #fff;
        font-size: 1.02rem;
        font-weight: 800;
        line-height: 1;
        box-shadow: 0 .15rem .35rem rgba(0, 0, 0, .12);
    }
    .val { font-size: 1.18rem; font-weight: 700; }
    .val-unit { font-size: .82rem; color: #6c757d; font-weight: 500; }
    .analyte-line { font-size: .78rem; color: #6c757d; font-style: italic; }
    .explain { font-size: .82rem; color: #5a6570; }
    .loinc-line { font-size: .72rem; color: #8a9099; }
    .loinc-dot { font-size: .8rem; line-height: 1; }

    .locked-bar {
        height: .72rem;
        border-radius: .35rem;
        background: linear-gradient(90deg, #dfe3e8 0%, #eef1f4 100%);
        margin: .3rem 0;
    }
    .locked-note { font-size: .76rem; color: #8a9099; font-style: italic; }

    .cta-inline {
        background: #e65100;
        border-color: #e65100;
        color: #fff;
        font-weight: 700;
        letter-spacing: .02em;
        transition: transform .15s ease, box-shadow .15s ease, background-color .15s ease;
    }
    .cta-inline:hover {
        background: #ff6f00;
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(230, 81, 0, .3);
    }
    .demo-stamp { letter-spacing: .3em; font-weight: 800; }
    .progress-card {
        background: #fff8e1;
        border: 1px solid #ffe082;
        border-radius: .6rem;
        padding: .85rem 1rem;
    }
    .report-sticky {
        position: fixed;
        left: 0; right: 0; bottom: 0;
        z-index: 1030;
        background: rgba(255, 255, 255, .97);
        backdrop-filter: blur(8px);
        border-top: 3px solid #e65100;
        box-shadow: 0 -.5rem 1.25rem rgba(0, 0, 0, .12);
    }
    @@media (max-width: 991.98px) {
        /* Tablet / medium windows: fluid typography + column widths so the row
           stays on one line without overlaps or horizontal scrolling. */
        .report-paper { padding: 1.75rem 1.5rem 2.25rem; }
        .rt colgroup col:nth-child(1) { width: 46% !important; }
        .rt colgroup col:nth-child(2) { width: 17% !important; }
        .rt colgroup col:nth-child(3) { width: 23% !important; }
        .rt colgroup col:nth-child(4) { width: 14% !important; }
        .rt .col-value { white-space: normal; padding-right: .6rem !important; }
        .rt .col-value .val-unit { display: block; }
        .rt .col-ref { padding-left: .6rem !important; }
        .rt thead th { font-size: clamp(.72rem, 1.6vw, .84rem); }
        .param-name { font-size: clamp(.9rem, 2.2vw, 1.05rem); }
        .val { font-size: clamp(.95rem, 2.4vw, 1.18rem); }
        .val-unit { font-size: clamp(.7rem, 1.6vw, .82rem); }
        .rt .col-ref { font-size: clamp(.78rem, 1.9vw, 1rem); }
        .explain { font-size: clamp(.76rem, 1.8vw, .82rem); }
        .analyte-line { font-size: clamp(.72rem, 1.7vw, .78rem); }
        .loinc-line { font-size: clamp(.68rem, 1.5vw, .72rem); }
        .status-chip { width: clamp(1.6rem, 3.6vw, 1.9rem); height: clamp(1.6rem, 3.6vw, 1.9rem); font-size: clamp(.9rem, 2vw, 1.02rem); }
    }
    @@media (max-width: 767px) {
        .report-paper { padding: 1.5rem 1.15rem 2rem; }
        .report-paper.demo-paper::before { font-size: 5rem; }
    }
    @@media (max-width: 575.98px) {
        /* Phone: every analyte becomes a compact card — name + status on the
           first line, then a value · reference strip, nothing squeezed. */
        .report-paper { padding: 1.25rem .85rem 1.75rem; }
        .rt { table-layout: auto; }
        .rt colgroup, .rt thead { display: none; }
        .rt tbody, .rt tr, .rt td { display: block; }
        .rt tbody tr { display: flex; flex-wrap: wrap; align-items: flex-start; padding: .65rem 0 .7rem; border-top: 1px solid #eceff3; }
        .rt tbody td { border-top: 0; padding: 0; }
        .rt tbody tr:hover td { background: transparent; }
        .rt tbody tr > td:first-child { order: 1; flex: 1 1 calc(100% - 3rem); min-width: 0; }
        .rt tbody td.col-status { order: 2; flex: 0 0 3rem; padding-left: .6rem; text-align: right; }
        .rt tbody td.col-value,
        .rt tbody td.col-ref {
            order: 3;
            flex: 0 0 auto;
            margin-top: .45rem;
            padding: .25rem .6rem !important;
            background: #f4f7fb;
            border-radius: .35rem;
            text-align: left;
            font-size: .86rem;
            white-space: normal;
        }
        .rt tbody td.col-ref { order: 4; flex: 1 1 0; min-width: 8rem; margin-left: .35rem; }
        .rt tbody td.col-value .val { font-size: 1rem; }
        .rt tbody td.col-value .val-unit { display: inline; font-size: .74rem; }
        .rt tbody td.col-value::before,
        .rt tbody td.col-ref::before {
            content: attr(data-label);
            display: block;
            font-size: .66rem;
            line-height: 1.2;
            margin-bottom: .1rem;
            text-transform: uppercase;
            letter-spacing: .03em;
            color: #8a9099;
            font-weight: 600;
        }
        .param-name { font-size: .98rem; }
        .explain { font-size: .8rem; }
        .rt tr.panel-row { display: block; padding: 0; border-top: 0; }
        .rt tbody tr.has-ref-note td.col-ref { display: none; }
        .rt tbody tr.rt-detail { display: block; border-top: 0; padding: 0 0 .7rem; margin-top: -.45rem; }
        .rt tbody tr.rt-detail td.rt-detail-cell { display: block; padding: 0; }
        .rt tbody tr.rt-main.has-detail, .rt tbody tr.rt-main.has-ref-note { padding-bottom: .35rem; }
        .rt tbody tr.ref-note-row { display: block; border-top: 0; padding: 0 0 .7rem; margin-top: -.45rem; }
        .rt tbody tr.ref-note-row td.ref-note { display: block; padding: 0; }
        .rt tr.panel-row td { display: block; padding: .4rem .6rem; border-radius: .3rem; }
        .rt tr.locked-row td.col-value,
        .rt tr.locked-row td.col-ref { flex: 1 1 40%; background: transparent; padding: 0 !important; }
        .rt tr.locked-row td.col-value::before,
        .rt tr.locked-row td.col-ref::before { content: none; }
    }
</style>

<div class="report-stage @(Model.IsFreemium ? "" : "pb-5")">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-9 col-lg-10">

                <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                    @if (Model.IsFreemium)
                    {
                        <span class="badge bg-warning text-dark demo-stamp" data-testid="report-screen-demo-badge">DEMO</span>
                    }
                    <span class="text-secondary small">
                        @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        @if (!string.IsNullOrWhiteSpace(Model.ProfileName))
                        {
                            <text> &middot; <strong>@Model.ProfileName</strong></text>
                        }
                    </span>
                    <div class="ms-auto d-flex gap-2">
                        <a asp-action="DownloadReport" asp-route-id="@Model.HistoryId"
                           class="btn btn-sm btn-primary" data-testid="report-screen-download-btn">
                            &#11015; @Loc.T("HistoryBtnDownloadPdf")
                        </a>
                        @if (Model.ProfileId.HasValue)
                        {
                            <a asp-action="History" asp-route-id="@Model.ProfileId.Value"
                               class="btn btn-sm btn-outline-secondary" data-testid="report-screen-back-btn">
                                &larr; @Loc.T("ScreenReportBackToHistory")
                            </a>
                        }
                    </div>
                </div>

                <div class="report-paper @(Model.IsFreemium ? "demo-paper" : "")">

                    @* ---------- Branded header, identical to the PDF ---------- *@
                    <div class="brand-head" data-testid="report-screen-brand-header">
                        <div class="brand-name">MyMedicalApp.NET</div>
                        <div class="brand-sub">@Loc.T("BrandSubtitle")</div>
                        <div class="brand-url">www.mymedicalapp.net</div>
                        <div class="brand-rule"></div>
                    </div>

                    <h1 class="h4 fw-bold text-primary mt-4 mb-3" data-testid="report-screen-heading">
                        @Loc.T("ScreenReportTitle")
                    </h1>

                    @* ---------- TOP: attention banner + CTA #1 (freemium only) ---------- *@
                    @if (Model.IsFreemium)
                    {
                        <div class="alert alert-warning border-start border-4 border-warning" data-testid="report-screen-attention">
                            <div class="fw-bold">@Loc.T("PdfFreemiumBannerTitle")</div>
                            <div class="small">@Loc.T("PdfFreemiumBannerBody")</div>
                            <div class="mt-2">
                                <span class="text-danger fw-bold">@Loc.T("PdfFreemiumAttentionWord")</span>
                                <span>- @Html.Raw(hi(Loc.T("PdfFreemiumAttentionLine")))</span>
                            </div>
                            <div class="small text-muted mt-2">@Loc.T("ScreenReportEmailedNote")</div>
                        </div>

                        @if (Model.TotalResultsCount > 0)
                        {
                            <div class="progress-card mb-3" data-testid="report-screen-progress">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <span class="fw-semibold small">
                                        @string.Format(Loc.T("ScreenReportVisibleResultsFmt"),
                                            Model.VisibleResultsCount, Model.TotalResultsCount)
                                    </span>
                                    <span class="small text-muted">
                                        @string.Format(Loc.T("ScreenReportLockedSectionsFmt"), Model.LockedCount)
                                    </span>
                                </div>
                                <div class="progress mt-2" style="height:.5rem;">
                                    <div class="progress-bar bg-success" role="progressbar"
                                         style="width:@visiblePct%" aria-valuenow="@visiblePct"
                                         aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        }

                        <div class="text-center my-4">
                            <a href="@buyUrl" class="btn btn-lg cta-inline px-4" data-testid="report-cta-top">
                                @Loc.T("PdfFreemiumUnlockButton")
                            </a>
                        </div>
                    }

                    @* ---------- Patient info (never hidden) ---------- *@
                    @if (Model.PatientInfo != null)
                    {
                        <div class="report-section-title">@Loc.T("PatientInfoSection")</div>
                        <div class="row g-2" data-testid="report-screen-patient-info">
                            @if (!string.IsNullOrWhiteSpace(Model.PatientInfo.Name))
                            {
                                <div class="col-md-6"><span class="text-muted">@Loc.T("PatientName"):</span> <strong>@Model.PatientInfo.Name</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.PatientInfo.Age))
                            {
                                <div class="col-md-6"><span class="text-muted">@Loc.T("PatientAge"):</span> <strong>@Model.PatientInfo.Age</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.PatientInfo.Sex))
                            {
                                <div class="col-md-6"><span class="text-muted">@Loc.T("PatientSex"):</span> <strong>@Model.PatientInfo.Sex</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.PatientInfo.DateTaken))
                            {
                                <div class="col-md-6"><span class="text-muted">@Loc.T("DateTaken"):</span> <strong>@Model.PatientInfo.DateTaken</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.PatientInfo.Laboratory))
                            {
                                <div class="col-md-6"><span class="text-muted">@Loc.T("Laboratory"):</span> <strong>@Model.PatientInfo.Laboratory</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.PatientInfo.DoctorRequesting))
                            {
                                <div class="col-md-6"><span class="text-muted">@Loc.T("DoctorRequesting"):</span> <strong>@Model.PatientInfo.DoctorRequesting</strong></div>
                            }
                        </div>
                    }

                    @* ---------- Summary: the teaser, always fully visible ---------- *@
                    @if (!string.IsNullOrWhiteSpace(Model.Summary))
                    {
                        <div class="report-section-title">@Loc.T("SummarySection")</div>
                        <p class="mb-0" data-testid="report-screen-summary">@Model.Summary</p>
                    }

                    @* ---------- Risk factors ---------- *@
                    @if (Model.RiskFactors.Count > 0)
                    {
                        <div class="report-section-title">@Loc.T("RiskFactorsSection")</div>
                        <div data-testid="report-screen-risk-factors">
                            @foreach (var rf in Model.RiskFactors)
                            {
                                <div class="mb-2 d-flex gap-2">
                                    <span class="@(rf.Locked ? "text-secondary" : "text-warning") fw-bold">&#9888;</span>
                                    <span class="flex-grow-1">
                                        @if (rf.Locked)
                                        {
                                            <div class="locked-bar" style="width:88%"></div>
                                            <div class="locked-bar" style="width:64%"></div>
                                            <div class="locked-note">&#128274; @lockedLabel</div>
                                        }
                                        else
                                        {
                                            @rf.Text
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                        <div class="alert alert-light border small fst-italic text-muted py-2 mt-3">
                            @Loc.T("RiskFactorsDisclaimer")
                        </div>
                    }

                    @* ---------- Key results table ---------- *@
                    @if (Model.KeyResults.Count > 0)
                    {
                        <div class="report-section-title">@Loc.T("KeyResultsSection")</div>
                        <div class="table-responsive">
                            <table class="rt" data-testid="report-screen-results-table">
                                @* Fixed widths: the analyte + explanation column gets the
                                   bulk of the row, while value / reference / status stay
                                   pinned to the right and can never be squeezed out. *@
                                <colgroup>
                                    <col style="width:48%" />
                                    <col style="width:15%" />
                                    <col style="width:24%" />
                                    <col style="width:13%" />
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>@Loc.T("Parameter")</th>
                                        <th class="col-value">@Loc.T("ValueLabel")</th>
                                        <th class="col-ref">@Loc.T("ReferenceRange")</th>
                                        <th class="col-status">@Loc.T("Status")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        string? lastPanel = null;
                                    }
                                    @foreach (var row in Model.KeyResults)
                                    {
                                        if (!string.IsNullOrWhiteSpace(row.PanelHeader) && row.PanelHeader != lastPanel)
                                        {
                                            lastPanel = row.PanelHeader;
                                            <tr class="panel-row">
                                                <td colspan="4">
                                                    @foreach (var lvl in row.PanelHeader!.Split(" | ", StringSplitOptions.RemoveEmptyEntries))
                                                    {
                                                        <div>@lvl.Trim()</div>
                                                    }
                                                </td>
                                            </tr>
                                        }

                                        if (row.Locked)
                                        {
                                            <tr class="locked-row rt-main" data-testid="report-screen-row-locked">
                                                <td>
                                                    <div class="locked-bar" style="width:62%"></div>
                                                </td>
                                                <td class="col-value"><div class="locked-bar" style="width:100%"></div></td>
                                                <td class="col-ref"><div class="locked-bar" style="width:100%"></div></td>
                                                <td class="col-status text-secondary fw-bold">?</td>
                                            </tr>
                                            <tr class="locked-row rt-detail">
                                                <td colspan="4" class="rt-detail-cell">
                                                    <div class="locked-bar" style="width:92%"></div>
                                                    <div class="locked-note">&#128274; @lockedLabel</div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            var s = st(row.Status);
                                            var refIsLong = MedicalApp.Services.ReferenceRangeDisplay.IsLong(row.ReferenceRange);
                                            var hasDetail = !string.IsNullOrWhiteSpace(row.Explanation) || !string.IsNullOrWhiteSpace(row.LoincCode);
                                            <tr class="rt-main @(refIsLong ? "has-ref-note" : "") @(hasDetail ? "has-detail" : "")">
                                                <td>
                                                    <div class="param-name" style="color:@s.Color">@row.Parameter</div>
                                                    @if (!string.IsNullOrWhiteSpace(row.AnalyteLine))
                                                    {
                                                        <div class="analyte-line">@row.AnalyteLine</div>
                                                    }
                                                </td>
                                                <td class="col-value" data-label="@Loc.T("ValueLabel")">
                                                    <span class="val" style="color:@s.Color">@row.Value</span>
                                                    @if (!string.IsNullOrWhiteSpace(row.Unit))
                                                    {
                                                        <span class="val-unit">&nbsp;@row.Unit</span>
                                                    }
                                                </td>
                                                <td class="col-ref" data-label="@Loc.T("ReferenceRange")"
                                                    title="@(refIsLong ? row.ReferenceRange : null)">@MedicalApp.Services.ReferenceRangeDisplay.Short(row.ReferenceRange)</td>
                                                <td class="col-status">
                                                    <span class="status-chip" style="background:@s.Color"
                                                          title="@row.Status">@Html.Raw(s.Arrow)</span>
                                                </td>
                                            </tr>
                                            @if (refIsLong)
                                            {
                                                <tr class="ref-note-row" data-testid="report-screen-ref-note">
                                                    <td colspan="4" class="ref-note">
                                                        <span class="ref-note-label">@Loc.T("ReferenceRange"):</span> @row.ReferenceRange
                                                    </td>
                                                </tr>
                                            }
                                            @if (hasDetail)
                                            {
                                                <tr class="rt-detail" data-testid="report-screen-row-detail">
                                                    <td colspan="4" class="rt-detail-cell">
                                                        @if (!string.IsNullOrWhiteSpace(row.Explanation))
                                                        {
                                                            <div class="explain">@row.Explanation</div>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(row.LoincCode))
                                                        {
                                                            <div class="loinc-line">
                                                                LOINC <strong>@row.LoincCode</strong>
                                                                @if (!string.IsNullOrWhiteSpace(row.LoincLongName))
                                                                {
                                                                    <text>&nbsp;&middot;&nbsp;@row.LoincLongName</text>
                                                                }
                                                                <span class="loinc-dot ms-1"
                                                                      style="color:@LoincSourceBadge.GetDotColor(row.LoincSource)"
                                                                      title="@LoincSourceBadge.GetTooltip(row.LoincSource)">&#9679;</span>
                                                                @if (!LoincSourceBadge.IsVerified(row.LoincSource) && row.LoincScore.HasValue)
                                                                {
                                                                    <text>@($" {(int)Math.Round(row.LoincScore.Value * 100)}%")</text>
                                                                }
                                                            </div>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (Model.HasLoincCodes)
                        {
                            <div class="loinc-line mt-2" data-testid="report-screen-loinc-legend">
                                <span class="loinc-dot" style="color:@LoincSourceBadge.GetDotColor(LoincSourceBadge.AnchorSource)">&#9679;</span>
                                @Loc.T("LoincSourceLegendVerified")
                                <span class="mx-2">&middot;</span>
                                <span class="loinc-dot" style="color:@LoincSourceBadge.GetDotColor(LoincSourceBadge.SemanticSource)">&#9679;</span>
                                @Loc.T("LoincSourceLegendAuto")
                            </div>
                        }

                        @* ---------- MIDDLE: CTA #2 (freemium only) ---------- *@
                        @if (Model.IsFreemium)
                        {
                            <div class="text-center my-4">
                                <a href="@buyUrl" class="btn btn-lg cta-inline px-4" data-testid="report-cta-middle">
                                    @Loc.T("PdfFreemiumUnlockButton")
                                </a>
                            </div>
                        }
                    }

                    @* ---------- Abnormal findings ---------- *@
                    @if (Model.AbnormalFindings.Count > 0)
                    {
                        <div class="report-section-title">@Loc.T("AbnormalFindingsSection")</div>
                        <div data-testid="report-screen-abnormal-findings">
                            @foreach (var f in Model.AbnormalFindings)
                            {
                                // Color follows the VALUE (red = high, blue = low,
                                // mustard = borderline). Severity is only a fallback
                                // for old interpretations where the analyte behind
                                // the finding can no longer be matched.
                                var hasStatus = !string.IsNullOrWhiteSpace(f.Status)
                                    && f.Status!.ToLowerInvariant() is "high" or "low" or "borderline";
                                var borderColor = f.Locked
                                    ? "#dadce0"
                                    : hasStatus
                                        ? st(f.Status).Color
                                        : f.Severity switch
                                        {
                                            "severe" => "#c62828",
                                            "moderate" => "#f9a825",
                                            _ => "#1565c0"
                                        };
                                <div class="ps-3 mb-3" style="border-left:5px solid @borderColor;">
                                    @if (f.Locked)
                                    {
                                        <div class="locked-bar" style="width:38%"></div>
                                        <div class="locked-bar" style="width:92%"></div>
                                        <div class="locked-note">&#128274; @lockedLabel</div>
                                    }
                                    else
                                    {
                                        <div class="fw-bold" style="color:@borderColor"
                                             data-testid="abnormal-finding-name">
                                            @f.Parameter
                                            @if (!string.IsNullOrWhiteSpace(f.Value))
                                            {
                                                <text>&nbsp;&mdash;&nbsp;</text>
                                                <span data-testid="abnormal-finding-value">@f.Value@(string.IsNullOrWhiteSpace(f.Unit) ? "" : " " + f.Unit)</span>
                                            }
                                        </div>
                                        <div>@f.Explanation</div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @* ---------- Correlations ---------- *@
                    @if (Model.Correlations.Count > 0)
                    {
                        <div class="report-section-title">@Loc.T("CorrelationsSection")</div>
                        <div data-testid="report-screen-correlations">
                            @foreach (var s in Model.Correlations)
                            {
                                if (s.Locked)
                                {
                                    <div class="mb-2">
                                        <div class="locked-bar" style="width:96%"></div>
                                        <div class="locked-bar" style="width:78%"></div>
                                    </div>
                                }
                                else
                                {
                                    <p class="mb-2">@s.Text</p>
                                }
                            }
                            @if (Model.Correlations.Any(x => x.Locked))
                            {
                                <div class="locked-note">&#128274; @lockedLabel</div>
                            }
                        </div>
                    }

                    @* ---------- Recommendations ---------- *@
                    @if (Model.Recommendations.Count > 0)
                    {
                        <div class="report-section-title">@Loc.T("RecommendationsSection")</div>
                        <div data-testid="report-screen-recommendations">
                            @foreach (var s in Model.Recommendations)
                            {
                                if (s.Locked)
                                {
                                    <div class="mb-2">
                                        <div class="locked-bar" style="width:96%"></div>
                                        <div class="locked-bar" style="width:70%"></div>
                                    </div>
                                }
                                else
                                {
                                    <p class="mb-2">@s.Text</p>
                                }
                            }
                            @if (Model.Recommendations.Any(x => x.Locked))
                            {
                                <div class="locked-note">&#128274; @lockedLabel</div>
                            }
                        </div>
                    }

                    @* ---------- Doctor questions ---------- *@
                    @if (Model.DoctorQuestions.Count > 0)
                    {
                        <div class="report-section-title">@Loc.T("DoctorQuestionsSection")</div>
                        <div data-testid="report-screen-doctor-questions">
                            @{ int qIndex = 0; }
                            @foreach (var q in Model.DoctorQuestions)
                            {
                                qIndex++;
                                <div class="mb-2 d-flex gap-2">
                                    <span class="@(q.Locked ? "text-secondary" : "text-primary") fw-bold">@(qIndex).</span>
                                    <span class="flex-grow-1">
                                        @if (q.Locked)
                                        {
                                            <div class="locked-bar" style="width:85%"></div>
                                            <div class="locked-bar" style="width:52%"></div>
                                            <div class="locked-note">&#128274; @lockedLabel</div>
                                        }
                                        else
                                        {
                                            @q.Text
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                        <div class="alert alert-light border small fst-italic text-muted py-2 mt-3">
                            @Loc.T("DoctorQuestionsDisclaimer")
                        </div>
                    }

                    @* ---------- Disclaimer ---------- *@
                    @if (!string.IsNullOrWhiteSpace(Model.Disclaimer))
                    {
                        <div class="report-section-title">@Loc.T("DisclaimerSection")</div>
                        <p class="small fst-italic text-muted mb-0">@Model.Disclaimer</p>
                    }

                    @* ---------- BOTTOM: final CTA #3 (freemium only) ---------- *@
                    @if (Model.IsFreemium)
                    {
                        <div class="alert alert-success border-start border-4 border-success mt-5" data-testid="report-screen-final-cta">
                            <div class="fw-bold fs-5">@Loc.T("PdfFreemiumCtaTitle")</div>
                            <div class="mt-1">@Html.Raw(hi(Loc.T("PdfFreemiumCtaBody")))</div>
                            <div class="text-center mt-3">
                                <a href="@buyUrl" class="btn btn-lg cta-inline px-4" data-testid="report-cta-bottom">
                                    @Loc.T("PdfFreemiumUnlockButton")
                                </a>
                            </div>
                        </div>
                    }

                    <div class="text-center mt-4">
                        <div class="fst-italic text-primary">@Loc.T("Tagline")</div>
                        <div class="small text-muted mt-1">www.mymedicalapp.net</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---------- Sticky unlock bar: always one tap from the paywall (freemium only) ---------- *@
@if (Model.IsFreemium)
{
    <div class="report-sticky" data-testid="report-sticky-bar">
        <div class="container py-2 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="small">
                <span class="text-danger fw-bold">@Loc.T("PdfFreemiumAttentionWord")</span>
                <span class="ms-1">@string.Format(Loc.T("ScreenReportLockedSectionsFmt"), Model.LockedCount)</span>
            </div>
            <a href="@buyUrl" class="btn cta-inline" data-testid="report-cta-sticky">
                @Loc.T("PdfFreemiumUnlockButton")
            </a>
        </div>
    </div>
}

@* Same finale jingle the Dashboard plays — the freemium user now lands here
   instead, so the audio cue has to follow them. TempData is single-shot. *@
@if (TempData["PlayInterpretationSuccessSound"] as string == "1")
{
    <script data-testid="interpretation-finish-sound-trigger">
        (function () {
            function fire() {
                if (window.DoctorMascot && typeof window.DoctorMascot.playInterpretationFinishSound === 'function') {
                    try { window.DoctorMascot.playInterpretationFinishSound(); } catch (e) { /* ignore */ }
                }
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function () { setTimeout(fire, 200); });
            } else {
                setTimeout(fire, 200);
            }
        })();
    </script>
}
