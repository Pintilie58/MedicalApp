@model IReadOnlyList<MedicalApp.Services.CreditPackage>
@{
    ViewData["Title"] = Loc.T("BuyCreditsTitle");
    var lowCreditsWarning = TempData["LowCreditsWarning"] as string;
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="text-primary fw-bold">@Loc.T("BuyCreditsTitle")</h2>
        <p class="text-muted">@Loc.T("BuyCreditsIntro")</p>
    </div>

    @if (!string.IsNullOrEmpty(lowCreditsWarning))
    {
        <div class="alert alert-warning text-center">@lowCreditsWarning</div>
    }

    <div class="alert alert-info d-flex justify-content-center align-items-center gap-3 flex-wrap">
        <span><strong>@Loc.T("PaidCreditsLabel"):</strong> @ViewBag.PaidRemaining</span>
        <span class="text-muted">|</span>
        <span><strong>@Loc.T("BonusCreditsLabel"):</strong> @ViewBag.BonusRemaining</span>
        <span class="text-muted">|</span>
        <span>
            <strong>@Loc.T("TotalAvailableLabel"):</strong>
            <span class="fw-bold text-success">@ViewBag.TotalAvailable</span>
        </span>
    </div>

    @if (ViewBag.PurchasesSuspended == true)
    {
        <div class="alert alert-warning text-center fs-5 py-4" data-testid="credits-suspended">
            <i class="bi bi-pause-circle me-2"></i>@Loc.T("PromoPurchasesSuspended")
        </div>
    }
    else if ((int)(ViewBag.DiscountPercent ?? 0) > 0)
    {
        <div class="alert alert-danger text-center fw-semibold" data-testid="credits-promo-banner">
            <i class="bi bi-tag-fill me-2"></i>@string.Format(Loc.T("PromoBannerBuy"), (int)ViewBag.DiscountPercent)
        </div>
    }

    <div class="row g-4 justify-content-center mt-2 @(ViewBag.PurchasesSuspended == true ? "d-none" : "")">
        @{
            // 3 boxes for CAM (Clinic audience) → col-lg-4 fills the row.
            // 4 boxes for B2C (Individual)     → col-lg-3 fills the row.
            // 1-2 boxes fall back to a tighter layout, still centered.
            var colCls = Model.Count switch
            {
                <= 2 => "col-md-6 col-lg-5",
                3    => "col-md-6 col-lg-4",
                _    => "col-md-6 col-lg-3"
            };
        }
        @foreach (var pkg in Model)
        {
            var isPopular = pkg.Key == "super" || pkg.Key == "cam_business";
            var cardClass = isPopular ? "border-primary shadow-lg pkg-popular" : "shadow-sm";
            <div class="@colCls">
                <div class="card h-100 border-0 @cardClass position-relative @(pkg.IsDiscounted ? "pkg-discounted" : "")" data-testid="package-card-@pkg.Key">
                    @if (isPopular)
                    {
                        <span class="badge bg-primary position-absolute start-50 px-3 py-2 pkg-popular-badge">
                            @Loc.T("MostPopular")
                        </span>
                    }
                    @if (pkg.IsDiscounted)
                    {
                        <span class="pkg-discount-ribbon" data-testid="package-discount-@pkg.Key">@string.Format(Loc.T("PromoBadgeOff"), pkg.DiscountPercent)</span>
                    }
                    <div class="card-body text-center d-flex flex-column">
                        <h4 class="card-title mt-2">@Loc.T(pkg.NameKey)</h4>
                        <div class="my-3">
                            @if (pkg.IsDiscounted)
                            {
                                <div class="pkg-old-price" title="@Loc.T("PromoOldPrice")">
                                    <s data-testid="package-old-price-@pkg.Key">@pkg.OriginalPriceEur!.Value.ToString("0")€</s>
                                </div>
                            }
                            <span class="display-4 fw-bold @(pkg.IsDiscounted ? "text-danger" : "text-primary")" data-testid="package-price-@pkg.Key">@pkg.PriceEur.ToString("0")€</span>
                            @if (pkg.IsDiscounted)
                            {
                                <div class="pkg-saving" data-testid="package-saving-@pkg.Key">@string.Format(Loc.T("PromoYouSave"), pkg.SavingEur.ToString("0.##"))</div>
                            }
                        </div>
                        <div class="mb-3">
                            <span class="fs-3 fw-semibold">@pkg.Credits</span>
                            <div class="text-muted small">@Loc.T("CreditsLabel")</div>
                        </div>
                        <div class="text-muted small mb-3">
                            @((pkg.PriceEur / pkg.Credits).ToString("0.00"))€ / @Loc.T("CreditUnit")
                        </div>
                        <a asp-action="Checkout" asp-route-package="@pkg.Key"
                           class="btn btn-primary mt-auto">
                            @Loc.T("ChoosePackage")
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-5">
        @{
            // Clinic users go back to the CAM dashboard so the navbar mode
            // stays B2B; Individual users keep the B2C destination.
            var _audienceForBack = ViewBag.Audience as string;
        }
        @if (string.Equals(_audienceForBack, "Clinic", StringComparison.OrdinalIgnoreCase))
        {
            <a asp-controller="Dashboard" asp-action="Index" asp-area="CAM"
               class="text-decoration-none small text-muted"
               data-testid="credits-back-to-cam">
                &larr; @Loc.T("BackToDashboard")
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Dashboard" asp-area=""
               class="text-decoration-none small text-muted"
               data-testid="credits-back-to-b2c">
                &larr; @Loc.T("BackToDashboard")
            </a>
        }
    </div>
</div>

<style>
    /* Make the "Most popular" ribbon sit fully inside the card, anchored
       at the top edge, so it isn't half-clipped above the card body. */
    .pkg-popular { padding-top: 18px; }
    .pkg-discounted { outline: 2px solid #dc3545; outline-offset: -2px; }
    .pkg-discount-ribbon {
        position: absolute; top: 14px; right: -6px; z-index: 6;
        background: #dc3545; color: #fff; font-weight: 800; font-size: .95rem; letter-spacing: .02em;
        padding: .3rem .8rem .3rem .9rem; border-radius: .35rem 0 0 .35rem;
        box-shadow: 0 4px 10px rgba(220, 53, 69, .35);
    }
    .pkg-discount-ribbon::after {
        content: ""; position: absolute; right: 0; bottom: -6px; border-width: 0 6px 6px 0;
        border-style: solid; border-color: transparent #a52834 transparent transparent;
    }
    .pkg-old-price { font-size: 1.25rem; color: #8a9099; line-height: 1; margin-bottom: .1rem; }
    .pkg-popular .pkg-discount-ribbon { top: 46px; }
    .pkg-saving { display: inline-block; margin-top: .35rem; font-size: .85rem; font-weight: 700; color: #b02a37; background: #fdecee; border-radius: 999px; padding: .15rem .7rem; }
    .pkg-popular-badge {
        top: 12px;
        transform: translateX(-50%);
        z-index: 5;
        box-shadow: 0 4px 10px rgba(13, 110, 253, 0.30);
        letter-spacing: 0.02em;
    }
</style>
