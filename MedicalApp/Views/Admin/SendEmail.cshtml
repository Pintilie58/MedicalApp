@model MedicalApp.Models.BulkEmailViewModel
@{
    ViewData["Title"] = "Admin - Bulk email";
    var filters = new[]
    {
        ("all",                     "All users"),
        ("paying",                  "Only paying users"),
        ("with_credits",            "Users with credits remaining"),
        ("registered_last_30_days", "Registered last 30 days"),
        ("blocked",                 "Blocked users only")
    };
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <h2 class="text-primary fw-bold mb-0">
            <i class="bi bi-envelope-paper"></i> Send bulk email
        </h2>
        <div class="ms-auto">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Dashboard</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="SendEmail" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Recipients filter</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var f in filters)
                        {
                            <a class="btn btn-sm @(Model.Filter == f.Item1 ? "btn-primary" : "btn-outline-primary")"
                               asp-action="SendEmail" asp-route-filter="@f.Item1">@f.Item2</a>
                        }
                    </div>
                    <input type="hidden" asp-for="Filter" />
                    <div class="text-muted small mt-2">
                        Will be sent to <strong>@Model.RecipientsCount</strong> recipients.
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label fw-semibold"></label>
                    <input asp-for="Subject" class="form-control" />
                    <span asp-validation-for="Subject" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="HtmlBody" class="form-label fw-semibold">
                        HTML body
                        <span class="text-muted fw-normal">(plain text is OK too)</span>
                    </label>
                    <div class="alert alert-info small mb-2">
                        <i class="bi bi-info-circle"></i>
                        Each email will be wrapped automatically:<br />
                        &nbsp;&nbsp;<strong>Header:</strong> <em>MyMedicalApp.NET - Intelligent interpretation of medical analyses</em><br />
                        &nbsp;&nbsp;<strong>Body:</strong> the text you write below<br />
                        &nbsp;&nbsp;<strong>Footer:</strong> <em>Be smart, take care of your health!</em>
                    </div>
                    <textarea asp-for="HtmlBody" rows="12" class="form-control font-monospace"
                              placeholder="&lt;p&gt;Hello,&lt;/p&gt;&lt;p&gt;Your message here...&lt;/p&gt;"></textarea>
                    <span asp-validation-for="HtmlBody" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg"
                        onclick="return confirm('Queue email for ' + @Model.RecipientsCount + ' recipients?');">
                    <i class="bi bi-send"></i> Send to @Model.RecipientsCount users
                </button>
            </form>

            @* June 2026: the send runs in a background worker, so the admin can
               leave this page. These rows are the progress. *@
            @{
                var recentJobs = ViewBag.RecentJobs as List<MedicalApp.Models.BulkEmailJob>
                                 ?? new List<MedicalApp.Models.BulkEmailJob>();
            }
            @if (recentJobs.Count > 0)
            {
                <div class="card mt-4" data-testid="bulk-email-jobs">
                    <div class="card-header d-flex align-items-center">
                        <strong>Background sends</strong>
                        <a asp-action="SendEmail" asp-route-filter="@Model.Filter"
                           class="btn btn-sm btn-outline-secondary ms-auto"
                           data-testid="bulk-email-refresh">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Started</th>
                                    <th>Subject</th>
                                    <th>Filter</th>
                                    <th>Status</th>
                                    <th class="text-end">Sent</th>
                                    <th class="text-end">Failed</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var j in recentJobs)
                                {
                                    <tr data-testid="bulk-email-job-row">
                                        <td class="small text-muted">@j.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                        <td class="small">@j.Subject</td>
                                        <td class="small text-muted">@j.Filter</td>
                                        <td>
                                            @if (j.Status == "running")
                                            {
                                                <span class="badge bg-primary">running</span>
                                            }
                                            else if (j.Status == "queued")
                                            {
                                                <span class="badge bg-secondary">queued</span>
                                            }
                                            else if (j.Status == "done")
                                            {
                                                <span class="badge bg-success">done</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger" title="@j.LastError">failed</span>
                                            }
                                        </td>
                                        <td class="text-end fw-semibold">@j.Sent / @j.Total</td>
                                        <td class="text-end @(j.Failed > 0 ? "text-danger fw-semibold" : "text-muted")">@j.Failed</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
