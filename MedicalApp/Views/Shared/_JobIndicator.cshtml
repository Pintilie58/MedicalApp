@*
    Top-right background-job indicator.
    Rendered on every page for logged-in users. Two states:
      * running  → amber pill "Fișier PDF în lucru! Așteptați!"
      * finished → green pill with a bell "Gata!" linking to the report.
    The finished state is remembered in localStorage, so it still greets the
    user if the job completed while they were on another site.
*@
<div id="jobIndicator" class="job-indicator" hidden data-testid="job-indicator">
    <div class="job-indicator-inner">
        <span id="jobIndicatorIcon" class="job-indicator-icon"></span>
        <a href="#" id="jobIndicatorText" class="job-indicator-text"
           data-testid="job-indicator-text"></a>
        <button type="button" id="jobIndicatorClose" class="job-indicator-close"
                aria-label="@Loc.T("CloseAria")" data-testid="job-indicator-close">&times;</button>
    </div>
</div>

<style>
    .job-indicator {
        position: fixed;
        top: 74px;
        right: 18px;
        z-index: 1800;
        animation: jobIndicatorIn 0.35s ease-out;
    }

    .job-indicator-inner {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 999px;
        background: #fff8e1;
        border: 1px solid #ffca28;
        box-shadow: 0 8px 24px rgba(13, 71, 161, 0.18);
        font-size: 0.9rem;
        font-weight: 600;
        color: #7a4f01;
        max-width: 78vw;
        flex-wrap: wrap;
    }

    .job-indicator.is-done .job-indicator-inner {
        background: #e8f5e9;
        border-color: #43a047;
        color: #1b5e20;
    }

    .job-indicator.is-failed .job-indicator-inner {
        background: #fdecea;
        border-color: #e53935;
        color: #a31515;
    }

    .job-indicator-text {
        color: inherit;
        text-decoration: none;
        white-space: nowrap;
    }

    .job-indicator.is-done .job-indicator-text {
        text-decoration: underline;
        cursor: pointer;
    }

    .job-indicator-icon {
        display: inline-flex;
        font-size: 1.05rem;
        line-height: 1;
    }

    .job-indicator.is-done .job-indicator-icon {
        animation: jobBellRing 1.1s ease-in-out 3;
        transform-origin: 50% 0;
    }

    .job-indicator-close {
        border: 0;
        background: transparent;
        color: inherit;
        font-size: 1.15rem;
        line-height: 1;
        padding: 0 2px;
        cursor: pointer;
        opacity: 0.6;
        transition: opacity 0.2s ease;
    }

        .job-indicator-close:hover { opacity: 1; }

    @@keyframes jobIndicatorIn {
        from { opacity: 0; transform: translateY(-8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes jobBellRing {
        0%, 100% { transform: rotate(0deg); }
        20% { transform: rotate(14deg); }
        40% { transform: rotate(-12deg); }
        60% { transform: rotate(8deg); }
        80% { transform: rotate(-5deg); }
    }
</style>

<script>
    (function () {
        var box = document.getElementById('jobIndicator');
        var textEl = document.getElementById('jobIndicatorText');
        var iconEl = document.getElementById('jobIndicatorIcon');
        var closeEl = document.getElementById('jobIndicatorClose');
        if (!box || !textEl) return;

        var T = {
            running: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("JobIndicatorRunning"))),
            queued: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("JobIndicatorQueuedFmt"))),
            done: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("JobIndicatorDone"))),
            failed: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("JobIndicatorFailed")))
        };
        var URL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Url.Action("JobStatus", "Interpretation")));

        // Keys survive navigation and full browser restarts, which is the whole
        // point: the job finishes on the server while the user is elsewhere.
        var K_WATCHING = 'mmaJobWatching';   // id of the job we saw running
        var K_PENDING = 'mmaJobPendingDone'; // "id|url" of a finish not acknowledged yet
        var K_FAILED = 'mmaJobPendingFail';

        function store(k, v) { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch (e) { } }
        function read(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }

        function show(state, label, href) {
            box.classList.remove('is-done', 'is-failed');
            if (state === 'done') box.classList.add('is-done');
            if (state === 'failed') box.classList.add('is-failed');
            iconEl.innerHTML = state === 'running'
                ? '<span class="spinner-border spinner-border-sm" role="status"></span>'
                : (state === 'done' ? '&#128276;' : '&#9888;');
            textEl.textContent = label;
            textEl.setAttribute('href', href || '#');
            box.hidden = false;
        }

        function hide() { box.hidden = true; }

        var jingled = false;
        function celebrate() {
            if (jingled) return;
            jingled = true;
            try {
                if (window.DoctorMascot && window.DoctorMascot.playInterpretationFinishSound) {
                    window.DoctorMascot.playInterpretationFinishSound();
                }
            } catch (e) { /* sound is a nicety */ }
        }

        closeEl.addEventListener('click', function () {
            store(K_PENDING, null);
            store(K_FAILED, null);
            hide();
        });

        textEl.addEventListener('click', function () {
            if (box.classList.contains('is-done')) {
                store(K_PENDING, null);
            }
        });

        // Re-show an unacknowledged finish immediately on page load.
        var pending = read(K_PENDING);
        if (pending) {
            show('done', T.done, pending.split('|')[1] || '#');
        } else if (read(K_FAILED)) {
            show('failed', T.failed, '#');
        }

        function poll() {
            // No point hammering the server while the tab is in the background —
            // we refresh right away when it becomes visible again.
            if (document.hidden) return;

            fetch(URL, { credentials: 'same-origin' })
                .then(function (r) {
                    if (r.status === 401) { stopPolling(); return null; }
                    return r.ok ? r.json() : null;
                })
                .then(function (d) {
                    if (!d) return;
                    syncPageBanner(d.running);

                    if (d.running) {
                        store(K_WATCHING, String(d.runningId || ''));
                        store(K_PENDING, null);
                        store(K_FAILED, null);
                        // Waiting in line vs actually being processed — the user
                        // needs to know the difference, otherwise a 10-minute
                        // wait looks like a broken app.
                        if (d.position > 0) {
                            var mins = Math.max(1, Math.round((d.etaSeconds || 0) / 60));
                            show('running',
                                String(T.queued).replace('{0}', d.position).replace('{1}', mins),
                                '#');
                        } else {
                            show('running', T.running, '#');
                        }
                        setRate(FAST);
                        return;
                    }

                    var watching = parseInt(read(K_WATCHING) || '0', 10);
                    if (!watching) { setRate(SLOW); return; } // nothing of ours was running

                    if (d.lastDoneId && d.lastDoneId >= watching) {
                        store(K_WATCHING, null);
                        store(K_PENDING, d.lastDoneId + '|' + (d.lastDoneUrl || ''));
                        show('done', T.done, d.lastDoneUrl || '#');
                        celebrate();
                        setRate(SLOW);
                    } else if (d.lastFailedId && d.lastFailedId >= watching) {
                        store(K_WATCHING, null);
                        store(K_FAILED, '1');
                        show('failed', T.failed, '#');
                        setRate(SLOW);
                    }
                })
                .catch(function () { /* best effort */ });
        }

        // A page rendered WHILE a job was running keeps its server-side banner
        // ("o interpretare rulează în fundal") forever, which then contradicts the
        // "Gata!" pill. The poll owns that banner from now on.
        function syncPageBanner(isRunning) {
            var banner = document.querySelector('[data-testid="interpretation-running-banner"]');
            if (banner) banner.hidden = !isRunning;
        }

        // 10s while we are following a job, 60s when idle — enough to notice a
        // job started in another tab without making this the most executed query
        // in the app (thousands of signed-in users × one poll each).
        var FAST = 10000, SLOW = 60000;
        var timer = null, rate = 0;
        function setRate(ms) {
            if (rate === ms) return;
            rate = ms;
            if (timer) clearInterval(timer);
            timer = setInterval(poll, ms);
        }
        function stopPolling() {
            if (timer) clearInterval(timer);
            timer = null;
            rate = -1;
        }

        document.addEventListener('visibilitychange', function () {
            if (!document.hidden && rate !== -1) poll();
        });

        setRate(read(K_WATCHING) ? FAST : SLOW);
        poll();
    })();
</script>
