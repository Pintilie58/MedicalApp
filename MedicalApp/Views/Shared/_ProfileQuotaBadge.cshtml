@*
    "3 of 20 profiles used" — shown only for the accounts a cap applies to
    (B2C: 20 profiles, Cabinet Medical: 2000 patients). Turns amber two slots
    before the limit and red once it is reached, so nobody is surprised.
*@
@{
    var _quotaApplies = ViewBag.ProfileCapApplies as bool? ?? false;
    var _quotaUsed = ViewBag.ProfileCount as int? ?? 0;
    var _quotaMax = ViewBag.ProfileLimit as int? ?? 0;
}
@if (_quotaApplies && _quotaMax > 0)
{
    var _quotaClass = _quotaUsed >= _quotaMax
        ? "bg-danger"
        : _quotaUsed >= _quotaMax - 2
            ? "bg-warning text-dark"
            : "bg-light text-secondary border";

    <span class="badge align-self-center @_quotaClass" data-testid="profile-quota-badge">
        @string.Format(Loc.T("ProfileQuotaBadge"), _quotaUsed, _quotaMax)
    </span>
}
